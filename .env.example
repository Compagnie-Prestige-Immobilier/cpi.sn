# Copy to .env for local development. In production these come from Dokploy's
# environment manager — never commit real values.

# Postgres. Locally you can run: docker compose up db
DATABASE_URI=postgres://cpi:cpi@localhost:5432/cpi

# Payload encryption key. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=change-me

# Public origin. Drives every canonical URL, hreflang tag, OG image, JSON-LD
# @id, robots.txt and the sitemap — so it MUST be the live origin in production:
#
#   SITE_URL=https://cpi.sn
#
# Read at RUNTIME. Do not rename it to NEXT_PUBLIC_*: that prefix means "inline
# this at build time", and the Docker image is built without it, so the value
# would freeze at the localhost default and nothing set in Dokploy could change
# it. NEXT_PUBLIC_SERVER_URL is still honoured as a fallback for local dev.
#
# Left unset (or on the localhost default) the app serves robots.txt as
# "Disallow: /" and marks every page noindex, deliberately: a staging deploy
# indexed under the wrong origin is duplicate content against the real site.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
#
# Left unset (or on the localhost default) the app serves robots.txt as
# "Disallow: /" and marks every page noindex, deliberately: a staging deploy
# indexed under the wrong origin is duplicate content against the real site.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Upload directory. Must point at the mounted volume in production.
MEDIA_DIR=./media

# ─── Analytics & Search Console (optional — leave blank until you have them) ───
# Both are read at runtime: set them in Dokploy and redeploy, no rebuild needed.

# Google Analytics 4 measurement ID, from Admin → Data streams. Must be the
# GA4 "G-" id, NOT a Tag Manager "GTM-" container or a legacy "UA-" property:
# anything else is rejected and analytics stays off rather than silently
# measuring nothing. Blank = no gtag script, no third-party request at all.
GA_MEASUREMENT_ID=

# Google Search Console ownership token — the value from the "HTML tag"
# verification method (just the content="…" part, not the whole tag).
GOOGLE_SITE_VERIFICATION=

# docker-compose only
POSTGRES_PASSWORD=cpi
