next-env.d.ts
# Reference material, kept out of the repo. LEADING SLASH IS REQUIRED: a bare
# `brand` also matches `public/brand/`, which silently excluded the logos the
# app actually serves — the Docker build then fails on `COPY /app/public`.
/brand
/content-audit
/ombarahtml-10
tsconfig.tsbuildinfo

# migration download cache (re-fetchable)
.migration-cache

# one-time mirror of the legacy WordPress uploads (large, back this up separately)
legacy-archive

CPI site redesign refresh 1
CPI site redesign refresh finale

# One-off image drops imported into Payload from the project root. Once
# imported they live in the (ignored) /media volume and ship to production
# inside seed/uploads/media.tar.gz.part-*, which IS committed — so keeping the
# loose originals here would duplicate several MB of binaries in git history.
#
# `founder.png` is the deliberate exception: `npm run seed:home` reads it from
# the project root on every run, so it has to stay tracked.
/*.webp
/*.jpg
/*.jpeg
/*.png
!/founder.png
!/AG.png
