{
  "name": "cpi-sn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:messages": "node scripts/check-messages.mjs",
    "check": "npm run check:messages && npm run check:legacy && npm run typecheck",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "import": "tsx src/migration/import.ts",
    "check:legacy": "node scripts/check-no-legacy.mjs",
    "archive:legacy": "node scripts/archive-legacy.mjs",
    "seed:dump": "bash -c 'pg_dump \"$DATABASE_URI\" --data-only --no-owner --no-privileges --exclude-table=users --exclude-table=users_sessions --exclude-table=payload_preferences --exclude-table=payload_preferences_rels --exclude-table=payload_locked_documents --exclude-table=payload_locked_documents_rels --exclude-table=leads --exclude-table=leads_rels --exclude-table=payload_migrations --exclude-table=payload_kv | gzip -9 > seed/cpi-seed.sql.gz && ls -lh seed/cpi-seed.sql.gz'",
    "seed:media": "bash -c 'rm -f seed/uploads/media.tar.gz.part-* && mkdir -p seed/uploads && tar cf - media | gzip -6 | split -b 40m - seed/uploads/media.tar.gz.part- && ls -lh seed/uploads/'",
    "seed:home": "tsx src/migration/seed-home.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "graphql": "^16.9.0",
    "next": "16.3.0",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.6",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  }
}
